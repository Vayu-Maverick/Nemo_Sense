<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Netra uses a custom dark theme for maximum contrast and accessibility -->
    <style name="Theme.Netra" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryVariant">@color/accent_blue_pressed</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color (same as primary for simplicity) -->
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorSecondaryVariant">@color/accent_blue_pressed</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Background and surface -->
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>

        <!-- Force dark mode always (critical for blind-accessible high contrast) -->
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
